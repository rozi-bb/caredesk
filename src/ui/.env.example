# Environment for the chat UI only. Copy to src/ui/.env.
# The UI never gets model keys or the database URL (ADR-0024).

# Where the backend API runs
BACKEND_URL=http://127.0.0.1:8000

# Signs the UI's own session cookie, at least 32 characters.
# Generate one with: uv run chainlit create-secret
CHAINLIT_AUTH_SECRET=
