# Environment for the Telegram bot only. Copy to src/telegram_bot/.env.
# The bot never gets model keys or the database URL (ADR-0027).

# Where the backend API runs
BACKEND_URL=http://127.0.0.1:8000

# Token from @BotFather. Anyone holding it controls the bot; if it leaks, /revoke it.
TELEGRAM_BOT_TOKEN=

# Key the bot uses to call the backend. Must match TELEGRAM_BOT_KEY in the root .env.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
TELEGRAM_BOT_KEY=
