# Salin file ini menjadi .env lalu isi nilainya.

# LangSmith: tracing dan evaluasi
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=caredesk

# Optional: Postgres database (default: the local Docker database from docker-compose.yml)
# DATABASE_URL=postgresql://caredesk:caredesk@localhost:5432/caredesk

# Backend: secret that signs sign-in tokens, at least 32 characters.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SECRET=
# Optional: how long a sign-in lasts, in minutes (default 480)
# AUTH_TOKEN_MINUTES=

# Penyedia model
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Jev (TypeSafe), for triage (ADR-0029). Backend only; never in the UI or bot .env.
TYPESAFE_API_KEY=
# Optional: default is TypeSafe's own API (https://api.typesafe.ai)
# TYPESAFE_BASE_URL=

# Telegram channel (ADR-0027)
# The bot's username from @BotFather, used to build the connect link
TELEGRAM_BOT_USERNAME=
# Key the bot uses to call the backend; same value as in src/telegram_bot/.env
TELEGRAM_BOT_KEY=
