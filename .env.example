# Salin file ini menjadi .env lalu isi nilainya.

# LangSmith: tracing dan evaluasi
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=caredesk

# Optional: Postgres database (default: the local Docker database from docker-compose.yml)
# DATABASE_URL=postgresql://caredesk:caredesk@localhost:5432/caredesk

# Backend: secret that signs sign-in tokens, at least 32 characters.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SECRET=
# Optional: how long a sign-in lasts, in minutes (default 480)
# AUTH_TOKEN_MINUTES=

# Penyedia model
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
